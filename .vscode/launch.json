{
    "version": "0.2.0",
    "configurations": [
        {
            // client side debug (先に npm run dev を起動しておく)
            "type": "chrome",
            "request": "launch",
            "name": "Clause Viewer: Client",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/clause-helper-app/dist"
        },
        {
            // テストのデバッグ
            "type": "node",
            "request": "launch",
            "name": "Clause Viewer: Tests",
            "cwd": "${workspaceFolder}/clause-helper-app",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--test", "src/**/*.spec.ts"],
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
