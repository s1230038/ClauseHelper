{
  "name": "clause-helper-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "条文ビューワー: 条文の漢数字（条・項）を算用数字に変換し、丸括弧を短縮・展開して表示するWebアプリ",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/serve.ts",
    "build": "node scripts/build.ts && tsc -p tsconfig.build.json",
    "start": "node scripts/serve.ts --dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.spec.ts\""
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "license": "ISC"
}
